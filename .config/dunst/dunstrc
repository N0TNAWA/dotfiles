[global]
    script = ~/.config/hypr/scripts/notifications.sh

    geometry = "300x50-20+20"
    font = "CaskaydiaMono Nerd Font 10"
    padding = 10
    transparency = 20
    corner_radius = 5
    frame_width = 0

    # Placeholder colors to be updated by the script
    background = "#0d0e12"
    foreground = "#d6bfae"
    frame_color = "#4E4F53"

[urgency_low]
    background = "#0d0e12"
    foreground = "#d6bfae"
    frame_color = "#4E4F53"
    icon_position = left

[urgency_normal]
    background = "#0d0e12"
    foreground = "#d6bfae"
    frame_color = "#4E4F53"
    icon_position = left

[urgency_critical]
    background = "#0d0e12"
    foreground = "#d6bfae"
    frame_color = "#4E4F53"
    icon_position = left

