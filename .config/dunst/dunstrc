[global]
    script = ~/.config/hypr/scripts/notifications.sh

    geometry = "300x50-20+20"
    font = "CaskaydiaMono Nerd Font 10"
    padding = 10
    transparency = 20
    corner_radius = 5
    frame_width = 0

    # Placeholder colors to be updated by the script
    background = "#140d0a"
    foreground = "#e9e5e0"
    frame_color = "#B19F92"

[urgency_low]
    background = "#140d0a"
    foreground = "#e9e5e0"
    frame_color = "#B19F92"
    icon_position = left

[urgency_normal]
    background = "#140d0a"
    foreground = "#e9e5e0"
    frame_color = "#B19F92"
    icon_position = left

[urgency_critical]
    background = "#140d0a"
    foreground = "#e9e5e0"
    frame_color = "#B19F92"
    icon_position = left

